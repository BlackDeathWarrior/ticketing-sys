{
  "name": "@tms/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations and seed data for TMS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "seed": "node --env-file-if-exists=../../.env dist/scripts/seed.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@tms/shared": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "~5.9.3"
  }
}
