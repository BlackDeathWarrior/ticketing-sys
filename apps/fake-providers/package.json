{
  "name": "@tms/fake-providers",
  "version": "0.1.0",
  "private": true,
  "description": "Stand-ins for external systems (an OpenAI-compatible LLM, a sample MCP server for Demo Store orders and payments; later Meta Graph and Sarvam) so demos and tests run offline",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  }
}
