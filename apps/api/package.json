{
  "name": "@tms/api",
  "version": "0.1.0",
  "private": true,
  "description": "TMS HTTP API (NestJS on Fastify)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@tms/db": "workspace:*",
    "@tms/shared": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.12.0",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "pino-pretty": "^13.0.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4"
  }
}
