{
  "name": "@tms/worker",
  "version": "0.1.0",
  "private": true,
  "description": "TMS background worker: outbox relay, queues, timers",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run -c vitest.int.config.ts"
  },
  "dependencies": {
    "@tms/db": "workspace:*",
    "@tms/shared": "workspace:*",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.6.0",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
