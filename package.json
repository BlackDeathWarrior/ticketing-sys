{
  "name": "ticketing-sys",
  "private": true,
  "description": "Omnichannel Ticket Management System with an AI first-level support agent",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:api dev:worker --parallel",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tms/db generate",
    "db:migrate": "pnpm --filter @tms/db migrate",
    "db:seed": "pnpm --filter @tms/db seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "docker:up": "docker compose -f infra/docker-compose.yml --profile app up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml --profile app down",
    "docker:logs": "docker compose -f infra/docker-compose.yml --profile app logs -f api worker web",
    "demo:email": "node apps/api/scripts/send-test-email.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
