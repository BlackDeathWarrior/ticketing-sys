# Copy to .env at the repo root. Values below match infra/docker-compose.yml.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3000
# Swagger UI at /docs (defaults to on outside production)
# API_DOCS=true
CORS_ORIGINS=http://localhost:5173

# Postgres (app database)
DATABASE_URL=postgres://tms:tms@localhost:5432/tms

# Redis (BullMQ queues, locks, presence)
REDIS_URL=redis://localhost:6379

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# LiteLLM proxy (all LLM traffic goes through it from Phase 3)
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-tms-dev-master-key
# Encrypts provider API keys stored in LiteLLM's database. Never change after first use.
LITELLM_SALT_KEY=sk-tms-dev-salt-key

# Object storage (attachments, KB documents)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tms
S3_SECRET_KEY=tms-dev-secret
S3_BUCKET=tms

# First admin account created by `pnpm db:seed`. Demo data defaults to on outside production.
# SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
