# Copy to .env at the repo root. Values below match infra/docker-compose.yml.

NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=3000
# Swagger UI at /docs (defaults to on outside production)
# API_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Postgres (app database)
DATABASE_URL=postgres://tms:tms@localhost:5432/tms

# Redis (BullMQ queues, locks, presence)
REDIS_URL=redis://localhost:6379

# Auth. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# LiteLLM proxy (all LLM traffic goes through it from Phase 3)
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-tms-dev-master-key
# Encrypts provider API keys stored in LiteLLM's database. Never change after first use.
LITELLM_SALT_KEY=sk-tms-dev-salt-key

# Encrypts stored channel/tool secrets (ADR 0009). 32 bytes, base64. Required in production:
#   openssl rand -base64 32
# TMS_SECRETS_KEY=

# Object storage (attachments, KB documents), any S3-compatible service.
# S3_AUTH=iam uses the AWS default credential chain (an instance role) instead of keys.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tms
S3_SECRET_KEY=tms-dev-secret
S3_BUCKET=tms

# First admin account created by `pnpm db:seed`. Demo data defaults to on outside production.
# SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Knowledge base: let URL sources point at private addresses (local demos only).
# KB_ALLOW_PRIVATE_URLS=false
# KB_INGEST_CONCURRENCY=2
# Concurrent AI jobs (turns and classifications) per worker.
# AI_CONCURRENCY=4

# Tools (MCP): host names that may resolve to private addresses, comma-separated
# (compose services such as fake-providers). Everything else must be public.
# TOOL_PRIVATE_HOSTS=
# Minutes a transactional tool call waits for a supervisor before it expires.
# APPROVAL_TTL_MINUTES=1440
# How often the worker checks SLA timers for at-risk and breached tickets.
# SLA_SWEEP_SECONDS=30
# How often the worker checks that the mail server and Meta still accept our
# credentials (the channel status lights). 0 turns the checks off.
# CHANNEL_CHECK_SECONDS=300

# Web chat widget: sites allowed to embed it ("*" = any), and the optional
# secret your site uses to sign identity tokens for logged-in visitors.
CHAT_ORIGINS=*
# CHAT_IDENTITY_SECRET=at-least-32-characters-shared-with-your-website

# Email channel. Dev: read support@tms.local in GreenMail, send via Mailpit.
EMAIL_ENABLED=true
EMAIL_ADDRESS=support@tms.local
EMAIL_FROM_NAME=TMS Support
EMAIL_IMAP_HOST=localhost
EMAIL_IMAP_PORT=3143
EMAIL_IMAP_SECURE=false
EMAIL_IMAP_USER=support@tms.local
EMAIL_IMAP_PASSWORD=support
EMAIL_POLL_SECONDS=30
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
