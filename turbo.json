{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL",
        "TEST_S3_ENDPOINT",
        "TEST_MAIL_HOST",
        "TEST_SMTP_PORT",
        "TEST_IMAP_PORT",
        "TEST_LITELLM_URL",
        "TEST_LITELLM_MASTER_KEY",
        "TEST_FAKE_LLM_URL",
        "TEST_LOG_LEVEL"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:api": {
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "cache": false,
      "persistent": true
    }
  }
}
